# A template for a deployment's environment, not a file the client reads itself.
# A shell, a compose file or a secret manager loads these. Copy to `.env` (ignored by git) and
# edit. Never commit a real key or token.

# --- the service -------------------------------------------------------------
AGENTS_URL=https://agents.shoutsid.fyi
# An operator key, never an admin token. Empty means the client cannot authenticate.
AGENTS_KEY=

# --- the model ---------------------------------------------------------------
# The deployment's fallback model chain. A project's policy may name a narrower one, and the
# service's task is the authority.
CONSULTANT_MODEL=
# The model process. The image installs `opencode` unless it is built with WITH_AGENT=0.
CONSULTANT_OPENCODE=opencode
CONSULTANT_AGENT=consultant
CONSULTANT_REVIEW_AGENT=reviewer
# Optional: a different model per task kind. Empty means the proposer's chain. A review answers
# yes or no, a scan reads a whole tree, and a presentation writes the longest text the client
# produces — moving one of them is a narrower spend than moving the chain every answer uses.
CONSULTANT_REVIEW_MODEL=
CONSULTANT_SCAN_MODEL=
CONSULTANT_PRESENT_MODEL=

# --- the loop ----------------------------------------------------------------
CONSULTANT_INTERVAL=300
CONSULTANT_CLAIM_LIMIT=1
CONSULTANT_KINDS=answer,review,profile,scan,intent,repair
CONSULTANT_TASK_TIMEOUT=600
# The mounted home: state, records and the shallow public mirrors live here.
CONSULTANT_HOME=/home/consultant
